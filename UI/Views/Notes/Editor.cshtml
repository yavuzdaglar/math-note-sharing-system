@{
    ViewData["Title"] = "Not Düzenle";
}

<button type="button" onclick="window.location.href='/Admin'" class="editor-back-btn fixed top-4 z-[9999] flex items-center gap-2 rounded-full border border-slate-200 bg-white/90 px-3 py-2 text-sm font-semibold text-slate-700 shadow-md backdrop-blur hover:bg-white dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-200">
    <i data-lucide="arrow-left" class="w-4 h-4"></i>
    <span>Geri</span>
</button>

<div class="editor-layout">
    <!-- Sol Sidebar: Blok Tipleri -->
    <div id="blockSidebar" class="editor-sidebar">
        <h3 class="sidebar-title">Yeni Bir Blok Ekleyin</h3>
        <div class="sidebar-block-list">
            <div class="sidebar-block-item" draggable="true" data-block-type="Heading" onclick="addBlock('Heading')">
                <div class="sidebar-block-icon"><i data-lucide="heading" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Başlık</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Subheading" onclick="addBlock('Subheading')">
                <div class="sidebar-block-icon"><i data-lucide="subtitles" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Alt Başlık</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Paragraph" onclick="addBlock('Paragraph')">
                <div class="sidebar-block-icon"><i data-lucide="type" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Paragraf</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="ImportantNote" onclick="addBlock('ImportantNote')">
                <div class="sidebar-block-icon"><i data-lucide="info" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Önemli Not</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Image" onclick="addBlock('Image')">
                <div class="sidebar-block-icon"><i data-lucide="image" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Resim</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Video" onclick="addBlock('Video')">
                <div class="sidebar-block-icon"><i data-lucide="video" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Video</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Gif" onclick="addBlock('Gif')">
                <div class="sidebar-block-icon"><i data-lucide="film" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">GIF</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Code" onclick="addBlock('Code')">
                <div class="sidebar-block-icon"><i data-lucide="code" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Kod</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="List" onclick="addBlock('List')">
                <div class="sidebar-block-icon"><i data-lucide="list" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Liste</span>
            </div>
            <div class="sidebar-block-item" draggable="true" data-block-type="Math" onclick="addBlock('Math')">
                <div class="sidebar-block-icon"><i data-lucide="sigma" class="w-5 h-5"></i></div>
                <span class="sidebar-block-label">Matematik</span>
            </div>
        </div>
    </div>

    <!-- Ana Alan -->
    <div class="editor-main">
        <div class="editor-container">
            <input type="text" id="noteTitle" class="note-title-input" placeholder="Not Başlığı..." />

            <div id="blockList" class="block-list">
                <!-- Bloklar buraya gelecek -->
            </div>
        </div>

        <!-- Grid Kolon Düzeni Seçme Paneli -->
        <div id="addGridPanel" class="grid-panel">
            <h3 class="grid-panel-title">Grid Kolon Düzeni Seçin</h3>
            <div class="grid-panel-buttons">
                <button draggable="true" onclick="addBlock('Grid', { columns: [1,1], columnBlocks: [[],[]] })" class="grid-layout-card" title="2 eşit kolon" data-grid-content='{"columns":[1,1],"columnBlocks":[[],[]]}'>
                    <div class="grid-layout-visual"><div class="gv-col gv-1-1"></div><div class="gv-col gv-1-1"></div></div>
                </button>
                <button draggable="true" onclick="addBlock('Grid', { columns: [1,2], columnBlocks: [[],[]] })" class="grid-layout-card" title="1/3 + 2/3" data-grid-content='{"columns":[1,2],"columnBlocks":[[],[]]}'>
                    <div class="grid-layout-visual"><div class="gv-col gv-1-3"></div><div class="gv-col gv-2-3"></div></div>
                </button>
                <button draggable="true" onclick="addBlock('Grid', { columns: [2,1], columnBlocks: [[],[]] })" class="grid-layout-card" title="2/3 + 1/3" data-grid-content='{"columns":[2,1],"columnBlocks":[[],[]]}'>
                    <div class="grid-layout-visual"><div class="gv-col gv-2-3"></div><div class="gv-col gv-1-3"></div></div>
                </button>
                <button draggable="true" onclick="addBlock('Grid', { columns: [1,1,1], columnBlocks: [[],[],[]] })" class="grid-layout-card" title="3 eşit kolon" data-grid-content='{"columns":[1,1,1],"columnBlocks":[[],[],[]]}'>
                    <div class="grid-layout-visual"><div class="gv-col gv-1-1"></div><div class="gv-col gv-1-1"></div><div class="gv-col gv-1-1"></div></div>
                </button>
                <button draggable="true" onclick="addBlock('Grid', { columns: [1,1,1,1], columnBlocks: [[],[],[],[]], layout: 'matrix2x2' })" class="grid-layout-card" title="2x2 matris" data-grid-content='{"columns":[1,1,1,1],"columnBlocks":[[],[],[],[]],"layout":"matrix2x2"}'>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:2px;width:48px;height:52px"><div class="gv-col"></div><div class="gv-col"></div><div class="gv-col"></div><div class="gv-col"></div></div>
                </button>
                <button draggable="true" onclick="addBlock('Grid', { columns: [1,1,1,1], columnBlocks: [[],[],[],[]], layout: 'four-columns' })" class="grid-layout-card" title="4 eşit kolon" data-grid-content='{"columns":[1,1,1,1],"columnBlocks":[[],[],[],[]],"layout":"four-columns"}'>
                    <div style="display:flex;gap:2px;width:48px;height:24px;align-items:stretch"><div class="gv-col gv-1-1"></div><div class="gv-col gv-1-1"></div><div class="gv-col gv-1-1"></div><div class="gv-col gv-1-1"></div></div>
                </button>
                <button draggable="true" onclick="addBlock('Grid', { columns: [1,1,2], columnBlocks: [[],[],[]], layout: 'top-two-bottom-wide' })" class="grid-layout-card" title="Üstte 2 kutu, altta uzun" data-grid-content='{"columns":[1,1,2],"columnBlocks":[[],[],[]],"layout":"top-two-bottom-wide"}'>
                    <div class="grid-layout-wide-bottom-visual"><div class="top-left"></div><div class="top-right"></div><div class="bottom-wide"></div></div>
                </button>
            </div>
        </div>

        <div class="editor-actions-bar">
            <button type="button" onclick="applyTemplate()" class="px-6 py-2 rounded-full text-sm font-bold text-amber-600 bg-amber-50 hover:bg-amber-100 transition-all flex items-center gap-2">
                <i data-lucide="sparkles" class="w-4 h-4"></i> Şablon Uygula
            </button>
            <button type="button" onclick="saveNote(false)" class="px-6 py-2 rounded-full text-sm font-bold text-gray-900 border border-gray-200 hover:bg-gray-50 transition-all">Taslak Kaydet</button>
            <button type="button" onclick="saveNote(true)"  class="px-8 py-2 rounded-full text-sm font-bold text-white bg-brand-teal hover:bg-brand-teal-light shadow-lg shadow-teal-100 transition-all">Yayınla</button>
        </div>
    </div>
</div>

<!-- Yayınlama Modalı -->
<div id="publishModal" class="hidden fixed inset-0 z-[9998] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closePublishModal()"></div>
    <div class="bg-white text-slate-900 relative z-10 w-full max-w-lg rounded-[3rem] p-10 shadow-2xl">
        <h3 class="text-2xl font-black text-slate-900 mb-2">Notu Yayınla</h3>
        <p class="text-slate-500 text-sm mb-8 font-medium">Bu notun hangi ders altında görüneceğini seçin.</p>
        <div class="space-y-6">
            <div>
                <label class="block text-xs font-black text-slate-400 uppercase mb-2 ml-2">Kategori</label>
                <select id="categorySelect" onchange="loadCourses(this.value)" class="w-full p-4 bg-slate-50 text-slate-900 border border-slate-100 rounded-2xl outline-none focus:ring-4 focus:ring-brand-teal/10">
                    <option value="">Kategori Seçin...</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-black text-slate-400 uppercase mb-2 ml-2">Ders</label>
                <select id="courseSelect" class="w-full p-4 bg-slate-50 text-slate-900 border border-slate-100 rounded-2xl outline-none focus:ring-4 focus:ring-brand-teal/10">
                    <option value="">Önce Kategori Seçin...</option>
                </select>
            </div>
            <div class="pt-4 flex gap-3">
                <button onclick="confirmPublish()" class="flex-1 py-5 bg-brand-teal text-white font-black rounded-2xl shadow-xl shadow-teal-100 hover:bg-brand-teal-light transition-all transform hover:scale-[1.02]">Onayla ve Yayınla</button>
                <button onclick="closePublishModal()" class="px-8 py-5 bg-slate-100 text-slate-500 font-bold rounded-2xl hover:bg-slate-200 transition-all">İptal</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
    <script src="~/js/block-editor.js?v=25"></script>
    <script>
        const noteId = @(ViewBag.NoteId ?? 0);

        async function fetchCategories() {
            try {
                const resp = await fetch('https://localhost:7078/api/coursecategories');
                const cats = await resp.json();
                const sel = document.getElementById('categorySelect');
                cats.forEach(c => { sel.innerHTML += `<option value="${c.id}">${c.name}</option>`; });
            } catch (e) { console.error('fetchCategories:', e); }
        }

        async function loadCourses(catId) {
            const sel = document.getElementById('courseSelect');
            sel.innerHTML = '<option value="">Ders Seçin...</option>';
            if (!catId) return;
            try {
                const resp = await fetch('https://localhost:7078/api/courses');
                const courses = await resp.json();
                courses.filter(c => c.courseCategoryId == catId)
                       .forEach(c => { sel.innerHTML += `<option value="${c.id}">${c.name}</option>`; });
            } catch (e) { console.error('loadCourses:', e); }
        }

        window.onload = async () => {
            await fetchCategories();
            if (noteId > 0) {
                await loadNote(noteId);
            }
        };
    </script>
}
