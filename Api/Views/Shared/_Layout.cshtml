@using Microsoft.AspNetCore.Mvc.ViewFeatures
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vurmaz Online</title>
    <link rel="icon" type="image/png" href="~/logo.png" />
    <script>
        (function () {
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                }
            } catch { }
        })();
    </script>
    <script src="https://cdn.tailwindcss.com/3.4.13"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/block-editor.css?v=16" />
    <script>
        // Tek host: UI ve API ayni origin'de. Bos string = relative /api/... kullanilir.
        window.API_BASE_URL = "";
    </script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'brand-navy': '#162d42',
                        'brand-teal': '#469d91',
                        'brand-teal-light': '#72b0a8'
                    }
                }
            }
        }
    </script>
<style>
        /* Sabit footer: her sayfada en altta durur */
        body { padding-bottom: 52px; }
        .site-footer {
            position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
            min-height: 44px; display: flex; align-items: center; justify-content: center;
        }
        /* Sabit alt barlarla cakismayi onle */
        #zoom-controls { bottom: 64px !important; }
        /* Sidebar + icerik duzeni: desktop acik, mobil cekmece */
        #main-content { padding-left: 16rem; }
        body.sidebar-closed #main-content { padding-left: 0; }
        @@media (min-width: 768px) {
            #sidebar { transform: translateX(0); }
            body.sidebar-closed #sidebar { transform: translateX(-100%); }
        }
        @@media (max-width: 767.98px) {
            #sidebar {
                transform: translateX(-100%);
                box-shadow: 0 25px 50px -12px rgba(0,0,0,.45);
            }
            body.sidebar-open #sidebar { transform: translateX(0); }
            #main-content { padding-left: 0 !important; }
            /* Dar ekranda grid kolonlari alt alta dizilir */
            #note-content-area .grid { grid-template-columns: 1fr !important; }
            .grid-container { grid-template-columns: 1fr !important; }
            .grid-col { min-width: 0; }
            img, video, canvas, iframe { max-width: 100%; }
            .math-rendered-block { overflow-x: auto; max-width: 100%; }
        }
    </style>
</head>
<body class="min-h-screen transition-all duration-500 overflow-x-hidden bg-white text-slate-900 dark:bg-[#0d161e] dark:text-slate-100">
    <button id="global-theme-toggle" data-theme-toggle class="fixed top-4 right-4 z-[9999] flex items-center gap-2 rounded-full border border-slate-200 bg-white/90 px-3 py-2 text-sm font-semibold text-slate-700 shadow-md backdrop-blur hover:bg-white dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-200" type="button" aria-label="Tema">
        <i data-lucide="moon" class="w-4 h-4"></i>
        <span class="hidden sm:inline">Karanlık</span>
    </button>

    <div id="toast-container" class="fixed bottom-16 right-4 z-[9999] flex flex-col gap-2"></div>

    @RenderBody()

    <footer class="site-footer border-t border-slate-200 bg-white/95 py-2.5 text-center backdrop-blur dark:border-slate-800 dark:bg-[#0b141b]/95">
        <p class="px-3 text-xs font-medium text-slate-500 dark:text-slate-400">
            © 2026 Vurmaz Online Notları
            <span class="mx-2 text-slate-300 dark:text-slate-600">•</span>
            Geliştirici: Yavuz Dağlar :
            <a href="https://github.com/yavuzdaglar" target="_blank" rel="noopener"
               class="inline-flex items-center gap-1 font-bold text-brand-teal hover:text-brand-teal-light hover:underline">
                <i data-lucide="github" class="w-3.5 h-3.5"></i>
                git
            </a>
        </p>
    </footer>

    <script src="https://unpkg.com/lucide@0.454.0/dist/umd/lucide.min.js" integrity="sha384-m/CoPp6wBQz6MoZXP+VveuxfvSx0NGXiQyyakzXVOVHgG1fP5bM/UiO4pSNPV6PT" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" integrity="sha384-7zkQWkzuo3B5mTepMUcHkMB5jZaolc2xDwL6VFqjFALcbeS9Ggm/Yr2r3Dy4lfFg" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" integrity="sha384-43gviWU0YVjaDtb/GhzOouOXtZMP/7XUzwPTstBeZFe/+rCMvRwr4yROQP43s0Xk" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.1.7/dist/purify.min.js" integrity="sha384-XQqX/4yiUGu+oyr87jvWzRuqBUK/adrY0DunhL+tID9m/9dwSpV8h9Fk/Sg6ifVQ" crossorigin="anonymous"></script>
    <script src="~/js/main.js?v=18"></script>
    <script type="module" src="~/js/gif-player.js?v=3"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>