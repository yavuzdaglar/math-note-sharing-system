@{
    var showAdminLogin = ViewData["ShowAdminLogin"] as bool? ?? false;
}

<header id="header" class="h-16 bg-[#1b3a52] dark:bg-[#0b141b] text-white fixed top-0 right-0 left-0 z-30 flex items-center justify-between px-3 md:px-6 pr-24 md:pr-36 border-b border-white/10 dark:border-slate-800 shadow-lg">
    <div class="flex items-center gap-2 md:gap-4 min-w-0">
        <button id="sidebar-toggle" class="p-2 hover:bg-white/10 rounded-lg transition-colors text-brand-teal-light shrink-0" title="Kenar çubuğunu gizle">
            <i data-lucide="menu" class="w-6 h-6"></i>
        </button>
        <div id="logo-triple-click" class="flex items-center gap-2 md:gap-3 cursor-pointer hover:opacity-80 transition-opacity min-w-0" onclick="handleLogoClick()">
            <img src="@Url.Content("~/logo.png")" alt="Vurmaz Online" class="w-9 h-9 md:w-11 md:h-11 rounded-xl object-cover shadow-lg ring-1 ring-white/10 shrink-0" />
            <h1 class="text-sm md:text-xl font-extrabold tracking-tight uppercase text-white truncate">
                <span class="text-brand-teal-light">VURMAZ ONLİNE</span> NOTLARI
            </h1>
        </div>
    </div>
    
</header>